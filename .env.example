# 이 파일을 .env 로 복사해서 필요한 줄만 고친다. .env 는 추적하지 않는다.
#
#   cp .env.example .env
#
# 아무것도 안 고쳐도 된다. 값을 비워 두면 아래 기본값으로 동작한다.
# 고칠 일이 생기는 것은 대개 포트가 이미 쓰이고 있을 때다.
#
# [중요] 이 파일은 Docker Compose 만 읽는다 — MySQL/Valkey 컨테이너를 어떻게 띄울지에만
# 관여한다. Spring(애플리케이션)은 이 파일을 아예 읽지 않으므로, 여기에 값을 적어도 앱에는
# 전달되지 않는다. 카카오 키, JWT_SECRET, CORS 허용 오리진처럼 앱이 직접 쓰는 값은
# application-local.yml(프로젝트 루트, .gitignore 로 막혀 있다)에 적거나 셸 환경변수로 준다.

# compose 가 띄우는 MySQL 의 호스트 포트. 3306 이 이미 쓰이면 여기만 바꾼다
MYSQL_PORT=3306

# 컨테이너 이름. 다른 프로젝트와 겹칠 때만 바꾼다
MYSQL_CONTAINER_NAME=freshmarket-mysql

MYSQL_DATABASE=freshmarket
MYSQL_USER=freshmarket
MYSQL_PASSWORD=freshmarket
MYSQL_ROOT_PASSWORD=root

# compose 가 띄우는 Valkey 의 호스트 포트. 6379 가 이미 쓰이면 여기만 바꾼다
VALKEY_PORT=6379

# 컨테이너 이름. 다른 프로젝트와 겹칠 때만 바꾼다
VALKEY_CONTAINER_NAME=freshmarket-valkey

# 아래 셋은 compose 를 쓰지 않고 다른 DB 에 붙을 때만 쓴다.
# bootRun 은 compose 가 띄운 컨테이너에서 접속 정보를 직접 읽으므로 평소엔 필요 없다.
# 이 값도 마찬가지로 여기 적어도 Spring 에는 전달되지 않는다 — 셸 환경변수로 줘야 한다.
#
# DB_URL=jdbc:mysql://localhost:3306/freshmarket?serverTimezone=UTC&characterEncoding=UTF-8
# DB_USERNAME=freshmarket
# DB_PASSWORD=freshmarket
