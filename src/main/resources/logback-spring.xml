<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ================================================================
         로컬: 사람이 읽기 좋은 콘솔 포맷 + MDC(traceId 등) 노출 + DEBUG

         application.yml 이 spring.profiles.default 를 local 로 두므로 프로필을 아무것도
         안 켠 실행도 이 블록에 걸린다. springProfile 은 기본 프로필도 활성으로 본다.
         ================================================================ -->
    <springProfile name="local">
        <!-- %line(파일명:라인번호)은 caller data가 필요해서 성능 비용이 있다. 로컬은 트래픽이
             적고 동기 로깅이라 부담이 작고, IntelliJ 콘솔은 "ClassName.java:42" 패턴을 인식해서
             클릭하면 바로 그 줄로 이동하는 링크로 만들어주기 때문에 로컬에서만 켠다. prod는
             AsyncAppender의 includeCallerData=false와 일관되게 caller data를 아예 안 켠다
             (비동기 로깅에서 caller data 계산 비용이 더 커지기 때문. 아래 prod 프로필 참고).

             주의: %logger{36} 바로 뒤에 괄호로 시작하는 리터럴("(%F:%line)")을 붙이면 Logback의
             PatternParser가 그 여는 괄호를 또 다른 컴포지트 컨버터(%word(...) 형태)의 시작으로
             오인해서 그 뒤 " - %msg%n"까지 파싱에 실패해 통째로 사라진다. 그래서 괄호 없이
             %F:%line으로 쓴다. 또한 %X{traceId:-} 같은 ":-" 기본값 문법은 Log4j2 전용이라
             Logback의 %X는 지원하지 않으므로(값이 없으면 그냥 빈 문자열) 콜론 없이 %X{traceId}로
             쓴다. -->
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>
                    %d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] [%X{traceId}] %X{method} %X{uri} %X{clientIp} %cyan(%logger{36}) %F:%line - %msg%n
                </pattern>
            </encoder>
        </appender>

        <!-- DEBUG 로 둔다. HttpBodyLoggingFilter 가 정상 응답의 요청/응답 본문을 DEBUG 에서만
             남기므로, 로컬에서 그 본문을 보려면 이 레벨이어야 한다.
             서드파티까지 전부 DEBUG 라 기동 로그가 길다. 줄이려면 시끄러운 것만 따로 올린다.
             예: <logger name="org.hibernate" level="INFO"/> -->
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ================================================================
         통합 테스트: 로그를 남기지 않는다.

         Testcontainers 기동, Flyway 마이그레이션, Hibernate 초기화가 클래스마다 반복되어
         정작 무엇이 실패했는지가 묻힌다. 실패 원인은 로그가 아니라 JUnit 리포트
         (build/test-results/integrationTest/*.xml)에 스택과 함께 남으므로 여기서 꺼도
         진단 수단이 사라지지 않는다.

         특정 테스트를 파고들 때는 이 블록의 레벨을 잠시 DEBUG 로 올린다.
         ================================================================ -->
    <springProfile name="integrationTest">
        <root level="OFF"/>
    </springProfile>

    <!-- ================================================================
         프로덕션: JSON 구조화 로그 (ELK / Loki / CloudWatch 수집용)
         의존성: net.logstash.logback:logstash-logback-encoder:8.0
         - MDC 필드(traceId, method, uri, clientIp)가 JSON 키로 자동 포함
         - AsyncAppender + neverBlock 으로 로깅이 요청 스레드를 막지 않게 함
         ================================================================ -->
    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>method</includeMdcKeyName>
                <includeMdcKeyName>uri</includeMdcKeyName>
                <includeMdcKeyName>clientIp</includeMdcKeyName>
                <!-- 스택트레이스 폭주 방지: 프레임/길이 제한 + 패키지 축약 -->
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>30</maxDepthPerThrowable>
                    <maxLength>8192</maxLength>
                    <shortenedClassNameLength>36</shortenedClassNameLength>
                    <rootCauseFirst>true</rootCauseFirst>
                    <exclude>^jdk\.internal\..*</exclude>
                    <exclude>^java\.lang\.reflect\..*</exclude>
                    <exclude>^org\.springframework\.web\.filter\..*</exclude>
                    <exclude>^jakarta\.servlet\..*</exclude>
                </throwableConverter>
                <customFields>{"service":"freshmarket"}</customFields>
            </encoder>
        </appender>

        <!--
             neverBlock=true 가 이 블록의 요점이다.

             false 로 두면 큐가 찼을 때 요청 스레드가 자리 날 때까지 기다린다. 그러면
             "로깅 I/O 가 요청 스레드를 블로킹하지 않게" 라는 이 appender 의 목적이
             포화 구간에서만 정확히 뒤집힌다. 로그가 제일 많이 나오는 때가 그 구간이다.

             실제로 그렇게 무너졌다. 2026-08-30 부하 시험에서 혼잡 24,000건이 몰리자
             큐가 차고 요청 스레드가 거기서 막혔다. 스레드가 묶이니 새 연결을 못 받아
             ALB 가 연결 오류 11,590건과 504 13,374건을 냈다. 혼잡이 5,134건이던 회차는
             연결 오류가 0 이었다.

             그래서 맞바꿈을 뒤집는다. 로그를 잃느니 느려지겠다에서, 느려지느니 로그를
             버리겠다로 간다. 버려도 건수는 coupon_issue_results_total 이 정확히 센다.

             queueSize 는 1024 에서 8192 로 올린다. 버리는 것은 마지막 수단이고, 순간의
             폭주는 큐가 흡수하는 것이 낫다. 이벤트는 인코딩 전 객체라 한 건이 가볍다.
        -->
        <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="JSON_CONSOLE"/>
            <queueSize>8192</queueSize>
            <!-- 0 이면 자리가 모자랄 때 INFO 이하를 미리 버리지 않는다 -->
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
            <includeCallerData>false</includeCallerData>
        </appender>

        <root level="INFO">
            <appender-ref ref="ASYNC_JSON"/>
        </root>
    </springProfile>

</configuration>
